# ============================================================
# AKSARAKU API — Environment Variables
# Salin file ini sebagai .env dan isi nilainya
# ============================================================

# ------------------------------------------------------------
# SUPABASE (Wajib)
# Dapatkan dari: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tabel & fungsi Supabase (sesuaikan jika berbeda dari default)
SUPABASE_TABLE=pdf_documents
SUPABASE_VECTOR_FUNCTION=match_pdf_documents
SUPABASE_KEYWORD_FUNCTION=search_pdf_documents_keyword
SUPABASE_EXACT_FUNCTION=search_pdf_documents_exact
SUPABASE_METADATA_COLUMN=metadata
SUPABASE_USE_METADATA=false

# Tabel sesi & pesan chat
SESSION_TABLE=chat_sessions
MESSAGE_TABLE=chat_messages
SESSION_HISTORY_LIMIT=4

# Tabel konfigurasi AI provider (opsional, buat manual di Supabase kalau mau)
# Kalau tidak ada, config diambil dari ENV ini saja.
AI_CONFIG_TABLE=ai_provider_config

# ------------------------------------------------------------
# EMBEDDING (Gemini — Wajib)
# Dapatkan API Key gratis di: https://aistudio.google.com/apikey
# Ganti HUGGINGFACE — tidak ada model lokal, tidak ada download
# ------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx

# Model embedding Gemini (text-embedding-004 paling optimal)
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Dimensi output vector (768 = akurasi tertinggi, 512 = balanced, 384 = backward compat)
# PENTING: harus sesuai dengan dimensi kolom vector di Supabase!
# Kalau existing data di Supabase pakai 384, set ke 384 juga.
EXPECTED_EMBEDDING_DIMENSION=768

# Jumlah retry kalau embedding API error
EMBEDDING_RETRIES=3

# ------------------------------------------------------------
# LLM PROVIDERS
# Priority default: Gemini → Groq → OpenRouter
# Minimal satu wajib diisi (Gemini sudah pakai key yang sama dengan embedding)
# ------------------------------------------------------------

# Gemini (Prioritas 1 — native SDK, paling cepat)
# Pakai API Key yang sama dengan embedding di atas
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Groq (Prioritas 2 — OpenAI-compatible, ultra-fast inference)
# Dapatkan API Key gratis di: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# OpenRouter (Prioritas 3 — last resort, akses 100+ model)
# Dapatkan API Key di: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Aksaraku

# ------------------------------------------------------------
# RAG (Retrieval-Augmented Generation) SETTINGS
# ------------------------------------------------------------
RAG_TOP_K=20
RAG_FINAL_K=8
RAG_MIN_SIMILARITY=0.20
COMPRESS_CONTEXT=false

# ------------------------------------------------------------
# TOKEN LIMITS
# ------------------------------------------------------------
MAX_INPUT_TOKENS=3500
MAX_CONTEXT_TOKENS=2000
MAX_OUTPUT_TOKENS=600

# ------------------------------------------------------------
# CORS — Whitelist Origin (WAJIB diisi untuk production)
# ------------------------------------------------------------
# Daftar domain frontend yang boleh akses API, pisah dengan koma.
# Development default: http://localhost:8080,http://localhost:8081
# Production: isi dengan domain aktual
# Contoh: ALLOWED_ORIGINS=https://smpn2cibungbulang.sch.id,https://aksaraku.vercel.app
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081
