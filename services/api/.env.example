# ============================================================
# AKSARAKU API — Environment Variables
# Salin file ini sebagai .env dan isi nilainya
# ============================================================

# ------------------------------------------------------------
# SUPABASE (Wajib)
# Dapatkan dari: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tabel & fungsi Supabase (sesuaikan jika berbeda dari default)
SUPABASE_TABLE=pdf_documents
SUPABASE_VECTOR_FUNCTION=match_pdf_documents
SUPABASE_KEYWORD_FUNCTION=search_pdf_documents_keyword
SUPABASE_EXACT_FUNCTION=search_pdf_documents_exact
SUPABASE_METADATA_COLUMN=metadata
SUPABASE_USE_METADATA=false

# Tabel sesi & pesan chat
SESSION_TABLE=chat_sessions
MESSAGE_TABLE=chat_messages
SESSION_HISTORY_LIMIT=4

# ------------------------------------------------------------
# EMBEDDING MODEL (HuggingFace — Wajib)
# Dapatkan API Key dari: https://huggingface.co/settings/tokens
# ------------------------------------------------------------
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EXPECTED_EMBEDDING_DIMENSION=384
HUGGINGFACE_EMBEDDING_RETRIES=3

# Model alternatif yang menghasilkan dimensi berbeda:
# - sentence-transformers/all-MiniLM-L6-v2  -> 384 dimensi (ringan, cepat)
# - BAAI/bge-m3                             -> 1024 dimensi (akurat, berat)
# CATATAN: Dimensi harus sesuai dengan kolom vector di Supabase!

# ------------------------------------------------------------
# LLM PROVIDERS (minimal satu wajib diisi)
# ------------------------------------------------------------

# Groq (Rekomendasi Utama - gratis tier tersedia)
# Dapatkan API Key dari: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# OpenRouter (Fallback - akses 100+ model)
# Dapatkan API Key dari: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Aksaraku

# Provider LLM utama yang digunakan terlebih dahulu
# Nilai: groq | openrouter
PRIMARY_LLM_PROVIDER=groq

# Maksimal percobaan pemilihan provider LLM (round-robin dengan fallback)
LLM_PROVIDER_MAX_ATTEMPTS=12

# ------------------------------------------------------------
# RAG (Retrieval-Augmented Generation) SETTINGS
# ------------------------------------------------------------
RAG_TOP_K=20
RAG_FINAL_K=8
RAG_MIN_SIMILARITY=0.20
COMPRESS_CONTEXT=false

# ------------------------------------------------------------
# TOKEN LIMITS
# ------------------------------------------------------------
MAX_INPUT_TOKENS=3500
MAX_CONTEXT_TOKENS=2000
MAX_OUTPUT_TOKENS=600
